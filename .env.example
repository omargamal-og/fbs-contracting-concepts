# Browser-safe values only. Copy to .env.local for frontend development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put service_role / sb_secret keys or database passwords in VITE variables.


# Optional public, URL-restricted Mapbox token. No map request without verified published coordinates.
VITE_MAPBOX_PUBLIC_TOKEN=
